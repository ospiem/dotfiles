# Login shell setup — runs once per login, before .zshrc.

# Homebrew: /opt/homebrew on Apple Silicon, /usr/local on Intel.
# shellenv exports HOMEBREW_PREFIX, which .zshrc reuses for PATH and fpath.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$_brew" ]; then
        eval "$("$_brew" shellenv)"
        break
    fi
done
unset _brew

# pipx-installed tools (also added in .zshrc for interactive shells).
export PATH="$PATH:$HOME/.local/bin"

# JetBrains Toolbox CLI launchers, only if Toolbox is installed.
_toolbox="$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
[ -d "$_toolbox" ] && export PATH="$PATH:$_toolbox"
unset _toolbox
