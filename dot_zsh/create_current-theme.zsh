# ANSI colour NUMBERS, not hex: 0-7 normal, 8-15 bright. These follow whatever
# palette kitty has loaded, so they need no per-theme values.
#   7 fg   15 bright fg   8 bright black (dim)   5 magenta   2 green
#   3 yellow   6 cyan   1 red
export FZF_DEFAULT_OPTS="
  --height 50%
  --layout=reverse
  --border rounded
  --color 'fg:7,fg+:15,hl:5,hl+:5'
  --color 'bg+:8,border:8,header:8,info:3'
  --color 'prompt:2,pointer:6,marker:1,spinner:3'
  --bind 'ctrl-/:toggle-preview'
"

# Ghost suggestion: bright black. Read at highlight time, so setting it here
# (after the plugin loaded) works.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# fast-syntax-highlighting. The array is created when the plugin loads, so this
# must run after it — which it does, being at the end of .zshrc.
if (( ${+FAST_HIGHLIGHT_STYLES} )); then
  FAST_HIGHLIGHT_STYLES[default]='fg=7'
  FAST_HIGHLIGHT_STYLES[command]='fg=2'
  FAST_HIGHLIGHT_STYLES[builtin]='fg=2'
