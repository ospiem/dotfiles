# Dotpak configuration file
# See https://github.com/ospiem/dotpak for documentation
#
# Content only. Everything chezmoi manages comes back with `chezmoi apply`, so
# it is deliberately absent here: a restore must never overwrite a rendered
# dotfile with a stale copy. Raycast extensions, zsh plugins and caches are
# re-downloaded or regenerated and are not worth 200 MB per day either.

# Items to backup (plaintext-safe, not in the dotfiles repo, not regenerable)
items = [
    ".codex/config.toml",
    ".codex/skills",
]

# Sensitive items (only backed up with encryption)
sensitive = [
    # SSH
    ".ssh",
    # GPG
    ".gnupg",
    # Cloud credentials
    ".aws",
    ".config/gcloud",
    ".azure",
    ".kube",
    ".s3cfg",
    ".yandex",
    # Terraform
    ".terraform.d",
    ".terraformrc",
    # Python credentials
    ".pypirc",
    # Docker (may contain registry auth)
    ".docker",
    # Shell history
    ".zsh_history",
    ".bash_history",
    ".lesshst",
    # AI tools (auth/tokens); ~/.claude has its own job, see claude-code.toml
    ".claude.json",
    ".codex/auth.json",
    ".ai",
    # Shell history databases
    ".local/share/atuin",   # atuin SQLite history (history.db + WAL files)
    # chezmoi prompt answers: both git identities, emails and signing key paths.
    # The single file, not the directory — chezmoistate.boltdb next to it is run
    # state that chezmoi rebuilds. Restore this BEFORE `chezmoi init`: with the
    # answers in place, init asks nothing and renders ~/.gitconfig.extra.
    ".config/chezmoi/chezmoi.toml",
]

[backup]
# Where to store backups. iCloud Drive on personal machines; a plain local
# directory elsewhere, since corporate policy may block iCloud entirely.
{{- if eq .profile "personal" }}
backup_dir = "{{ .chezmoi.homeDir }}/Library/Mobile Documents/com~apple~CloudDocs/backups/dotfiles"
{{- else }}
backup_dir = "{{ .chezmoi.homeDir }}/backups/dotfiles"
{{- end }}

# Number of backups to keep
max_backups = 14

# Encryption: "age" | "gpg" | "none"
encryption = "age"

# Recipients: the cron key plus every YubiKey, so an archive opens with the
# YubiKey identity below (two touches per restore: scan, then extract) or with
# the cron key once ~/.config/age/cron-identity.txt.age is decrypted.
age_recipients = "~/.config/age/cron-recipient.txt"

# Identity for decryption: YubiKey stubs, regenerated on a new machine with
# `age-plugin-yubikey --identity > ~/.config/age/identity`.
age_identity_files = ["~/.config/age/identity"]

# Exclude patterns. Never add generic dev patterns like *.md or *.sh here: they
# match every path component and would gut .codex/skills.
[excludes]
patterns = [
    # General
    ".git",
    ".idea",
    "*.log",
    "*.swp",
    "*.bak",
    ".DS_Store",
    "*.sock",
    "*.cache",
    # Python / Node artifacts inside skills
    "*.pyc",
    "__pycache__",
    ".venv",
    "venv",
    "node_modules",
    # Terraform
    "*.tfstate",
    "*.tfstate.*",
    # GPG transient
    "S.gpg-agent*",
    "random_seed",
    "*.status",
    # Docker transient
    ".token_seed*",
    "buildx/refs",
    "buildx/activity",
    "buildx/.lock",
    # SSH transient
    "known_hosts.old",
    # Zsh compiled
    "*.zwc",
]

# Named profiles
# Use with: dotpak backup --profile work
# [profile.work]
# extra_items = [".config/slack"]

# Hostname-specific settings (applied automatically)
# [host.my-macbook]
# extra_items = [".config/work-specific"]
